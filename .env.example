# Copy to .env (gitignored) and fill in what you need.

# Where the FitSys scheduler lives. Only needed if it is not the sibling
# directory ../FitSys -- that is the default.
FITSYS_HOME=

# --- How notifications are delivered ------------------------------------- #
# Leave NOTIFY_CHANNEL empty and whichever channel is configured wins, Telegram
# first, then e-mail. Set it to telegram / email / viber / console to pin one.
NOTIFY_CHANNEL=telegram

# Telegram, the easiest channel: free, self-serve, nothing to host.
#   1. In Telegram, message @BotFather -> /newbot -> copy the token here.
#   2. Find your new bot and send it any message (/start will do). A bot may
#      only write to someone who has written to it first.
#   3. Run:  .venv/bin/python -m notifier.cli --telegram-chat-id
#      and paste the id it prints below.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail, the default channel: free, no approval, no regulator. SMTP_PASS must
# usually be an APP-SPECIFIC password, not the account password:
#   Yahoo   smtp.mail.yahoo.com  port 465   Account Security > Generate app password
#   Gmail   smtp.gmail.com       port 465   App passwords (needs 2-step verification)
#   Outlook smtp-mail.outlook.com port 587
# SMTP_PORT defaults to 465 (implicit TLS); 587 uses STARTTLS. Port 25 is
# refused. MAIL_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=

# Viber. Only worth configuring for a bot registered BEFORE 5 February 2024 --
# newer bots carry a EUR 100/month maintenance fee plus per-message delivery
# charges, and cannot be self-registered. VIBER_RECEIVER is your own user id:
# either read `sender.id` from a Message callback, or POST to
# https://chatapi.viber.com/pa/get_account_info and take your `id` from the
# `members` array. A CA-signed HTTPS webhook must be set before 1-on-1
# messaging works, and you must have messaged the bot once to subscribe.
VIBER_TOKEN=
VIBER_RECEIVER=
VIBER_SENDER_NAME=

# Whose classes to watch. Give the full name -- FitSys abbreviates surnames in
# the calendar ('Фани М' for 'Фани Малинова') and that is matched for you.
# Required: leave it empty and the app refuses to run rather than quietly
# watching all ~300 classes in the studio (pass --all if that is what you want).
NOTIFY_INSTRUCTOR=Фани

# How far ahead to watch, in days (default 14).
NOTIFY_DAYS=

# Unattended sign-in. Not needed if you have run `fitsys connect` in the
# scheduler -- both apps share its var/cookies.json. Cron has no browser, so a
# machine that only runs this app needs these.
FITSYS_USER=
FITSYS_PASS=
